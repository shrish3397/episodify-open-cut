# Episodify Open Cut - Environment Configuration
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# Google Gemini API Key (for AI narrative segmentation with Gemini 3.8 Flash)
GEMINI_API_KEY=

# Local Ollama endpoint (optional, defaults to http://localhost:11434)
OLLAMA_HOST=http://localhost:11434
